            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "title": "Key",
            "type": "string"
          },
          "model_hash": {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "title": "Model Hash",
            "type": "string"
          },
          "rollup_version": {
            "minLength": 1,
            "title": "Rollup Version",
            "type": "string"
