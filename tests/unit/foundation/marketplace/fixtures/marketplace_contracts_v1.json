        "title": "Version",
        "type": "integer"
      },
      "visibility": {
        "$ref": "#/$defs/ListingVisibility"
      }
    },
    "required": [
      "listing_id",
      "script_hash",
      "version",
      "visibility",
      "price",
      "compat",
      "reputation"
    ],
    "title": "ScriptListing",
    "type": "object"
  },
