      },
      "ListingVisibility": {
        "description": "spec \u00a73.5 `Visibility = public|protected|invite|private` verbatim --\ninventing a fifth tier is forbidden, this enum is the single source of\ntruth for MP-2's `domain/visibility.py`.\n\n`PROTECTED` means the script source is never exposed to a subscriber --\nserver-side execution only, with the reproducibility key published\ninstead of the source (MP-2 owns enforcing that; this contract only\nnames the tier).",
        "enum": [
          "PUBLIC",
          "PROTECTED",
          "INVITE",
          "PRIVATE"
        ],
        "title": "ListingVisibility",
        "type": "string"
      },
      "PriceKind": {
        "description": "spec \u00a73.5 `price: OneTime|Subscription{period, trial_days}`.",
        "enum": [
          "ONE_TIME",
          "SUBSCRIPTION"
        ],
        "title": "PriceKind",
        "type": "string"
      },
