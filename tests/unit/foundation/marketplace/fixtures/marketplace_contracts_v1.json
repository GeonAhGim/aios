          "data_lineage_hash",
          "rollup_version",
          "config_hash",
          "model_hash",
          "key"
        ],
        "title": "ReproductionKey",
        "type": "object"
      },
      "ReputationSnapshot": {
        "description": "spec \u00a73.5 `ReputationScore{verified_runs, reproduced_backtests,\ndispute_rate, weighted_score}`; \u00a74.3 gives the weighting formula\n(`0.5*f(verified_runs) + 0.3*g(reproduced_backtests) +\n0.2*(1 - dispute_rate)`) that MP-4's `domain/reputation.py` computes --\n`weighted_score` here is a *reported* value this contract accepts as\ngiven, not a value it derives, which is what keeps MP-1 schema-only.",
        "properties": {
          "dispute_rate": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
