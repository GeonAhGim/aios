      },
      "open_time": {
        "format": "date-time",
        "title": "Open Time",
        "type": "string"
      },
      "quote_volume": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          },
          {
