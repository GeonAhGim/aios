        "type": "string"
      }
    },
    "properties": {
      "close_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Close At"
      },
      "early_close": {
        "default": false,
        "title": "Early Close",
        "type": "boolean"
      },
      "is_trading_day": {
        "title": "Is Trading Day",
        "type": "boolean"
      },
      "open_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Open At"
      },
      "schema_version": {
        "const": "v1",
        "default": "v1",
        "title": "Schema Version",
        "type": "string"
      },
      "source": {
        "title": "Source",
        "type": "string"
      },
      "trade_date": {
        "format": "date",
        "title": "Trade Date",
        "type": "string"
      },
      "venue": {
        "$ref": "#/$defs/Venue"
      }
    },
    "required": [
      "venue",
      "trade_date",
      "is_trading_day",
      "open_at",
      "close_at",
      "source"
    ],
    "title": "CalendarDay",
    "type": "object"
  },
