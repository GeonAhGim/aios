      },
      "LedgerEventType": {
        "enum": [
          "TOPUP_CONFIRMED",
          "HOLD_PLACED",
          "HOLD_CAPTURED",
          "HOLD_RELEASED",
          "REFUND",
          "CHARGEBACK",
          "PAYOUT_RELEASE",
          "PAYOUT_PAID",
          "MANUAL_ADJUSTMENT"
