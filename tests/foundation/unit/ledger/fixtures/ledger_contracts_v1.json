      "actor_subject_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Actor Subject Id"
      },
      "amount": {
        "anyOf": [
          {
            "exclusiveMinimum": 0.0,
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "title": "Amount"
      },
      "currency": {
        "$ref": "#/$defs/Currency",
        "default": "KRW"
      },
      "event_ref": {
        "title": "Event Ref",
        "type": "string"
      },
      "event_type": {
        "$ref": "#/$defs/LedgerEventType"
      },
      "extra": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "default": {},
        "title": "Extra",
        "type": "object"
      },
      "fund_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Fund Id"
      },
      "parties": {
        "additionalProperties": {
          "format": "uuid",
          "type": "string"
        },
        "title": "Parties",
        "type": "object"
      },
      "portfolio_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Portfolio Id"
      },
      "schema_version": {
        "const": "v1",
        "default": "v1",
        "title": "Schema Version",
        "type": "string"
      },
      "tenant_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Tenant Id"
      },
      "trace_id": {
        "format": "uuid",
        "title": "Trace Id",
        "type": "string"
      }
    },
    "required": [
      "event_type",
      "event_ref",
      "tenant_id",
      "actor_subject_id",
      "trace_id",
      "amount",
      "parties"
    ],
    "title": "LedgerEvent",
    "type": "object"
  },
