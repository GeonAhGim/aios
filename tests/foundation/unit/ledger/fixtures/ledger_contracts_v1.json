          },
          "side": {
            "$ref": "#/$defs/Side"
          }
        },
        "required": [
          "line_no",
          "account_code",
          "side",
          "amount",
          "currency"
        ],
        "title": "PostingLine",
        "type": "object"
      },
      "Side": {
        "enum": [
          "DEBIT",
          "CREDIT"
        ],
        "title": "Side",
        "type": "string"
      }
