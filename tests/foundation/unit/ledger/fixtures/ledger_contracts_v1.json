        "title": "Entry Hash",
        "type": "string"
      },
      "entry_id": {
        "format": "uuid",
        "title": "Entry Id",
        "type": "string"
      },
      "event_ref": {
        "title": "Event Ref",
        "type": "string"
      },
      "event_type": {
        "$ref": "#/$defs/LedgerEventType"
      },
      "idempotency_key": {
        "title": "Idempotency Key",
        "type": "string"
      },
      "lines": {
        "items": {
          "$ref": "#/$defs/PostingLine"
        },
        "title": "Lines",
        "type": "array"
      },
      "lines_digest": {
        "title": "Lines Digest",
        "type": "string"
      },
      "posted_at": {
        "format": "date-time",
        "title": "Posted At",
        "type": "string"
      },
      "prev_hash": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Prev Hash"
      },
      "replayed": {
        "default": false,
        "title": "Replayed",
        "type": "boolean"
      },
      "schema_version": {
        "const": "v1",
        "default": "v1",
        "title": "Schema Version",
        "type": "string"
      },
