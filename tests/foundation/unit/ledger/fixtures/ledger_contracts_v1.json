          "account_code": {
            "title": "Account Code",
            "type": "string"
          },
          "amount": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "currency": {
            "$ref": "#/$defs/Currency"
          },
          "line_no": {
