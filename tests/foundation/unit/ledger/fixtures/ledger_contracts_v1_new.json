{
  "LedgerEvent": {
    "$defs": {
      "Currency": {
        "enum": [
          "USDT",
          "KRW"
        ],
        "title": "Currency",
        "type": "string"
      },
      "LedgerEventType": {
        "enum": [
          "TOPUP_CONFIRMED",
          "HOLD_PLACED",
          "HOLD_CAPTURED",
          "HOLD_RELEASED",
          "REFUND",
          "CHARGEBACK",
          "PAYOUT_RELEASE",
          "PAYOUT_PAID",
          "MANUAL_ADJUSTMENT"
        ],
        "title": "LedgerEventType",
        "type": "string"
      }
    },
    "description": "`post_entry`(LC-9)의 입력. `event_ref`는 \"purchase:123\" 형태의\n도메인 참조이며, `idempotency_key`(LC-3)는 이로부터 파생된다.",
    "properties": {
      "event_type": {
        "$ref": "#/$defs/LedgerEventType"
      },
      "event_ref": {
        "title": "Event Ref",
        "type": "string"
      },
      "tenant_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Tenant Id"
      },
      "actor_subject_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Actor Subject Id"
      },
      "trace_id": {
        "format": "uuid",
        "title": "Trace Id",
        "type": "string"
      },
      "amount": {
        "anyOf": [
          {
            "exclusiveMinimum": 0.0,
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          }
        ],
        "title": "Amount"
      },
      "currency": {
        "$ref": "#/$defs/Currency",
        "default": "KRW"
      },
      "parties": {
        "additionalProperties": {
          "format": "uuid",
          "type": "string"
        },
        "title": "Parties",
        "type": "object"
      },
      "extra": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "string"
            }
          ]
        },
        "default": {},
        "title": "Extra",
        "type": "object"
      },
      "fund_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Fund Id"
      },
      "portfolio_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Portfolio Id"
      },
      "schema_version": {
        "const": "v1",
        "default": "v1",
        "title": "Schema Version",
        "type": "string"
      }
    },
    "required": [
      "event_type",
      "event_ref",
      "tenant_id",
      "actor_subject_id",
      "trace_id",
      "amount",
      "parties"
    ],
    "title": "LedgerEvent",
    "type": "object"
  },
  "PostingLine": {
    "$defs": {
      "Currency": {
        "enum": [
          "USDT",
          "KRW"
        ],
        "title": "Currency",
        "type": "string"
      },
      "Side": {
        "enum": [
          "DEBIT",
          "CREDIT"
        ],
        "title": "Side",
        "type": "string"
      }
    },
    "description": "분개 행 하나. `amount`는 항상 양수 — 방향은 `side`가 표현한다\n(§3.3 원장 금액 NUMERIC(20,2) KRW quantize).",
    "properties": {
      "line_no": {
        "title": "Line No",
        "type": "integer"
      },
      "account_code": {
        "title": "Account Code",
        "type": "string"
      },
      "side": {
        "$ref": "#/$defs/Side"
      },
      "amount": {
        "anyOf": [
          {
            "exclusiveMinimum": 0.0,
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
            "type": "string"
          }
        ],
        "title": "Amount"
      },
      "currency": {
        "$ref": "#/$defs/Currency"
      }
    },
    "required": [
      "line_no",
      "account_code",
      "side",
      "amount",
      "currency"
    ],
    "title": "PostingLine",
    "type": "object"
  },
