          },
          "side": {
            "$ref": "#/$defs/Side"
          },
          "amount": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "currency": {
            "$ref": "#/$defs/Currency"
          }
        },
        "required": [
          "line_no",
          "account_code",
          "side",
          "amount",
          "currency"
        ],
        "title": "PostingLine",
        "type": "object"
      },
      "Side": {
        "enum": [
          "DEBIT",
          "CREDIT"
        ],
        "title": "Side",
        "type": "string"
      }
    },
    "properties": {
      "entry_id": {
        "format": "uuid",
        "title": "Entry Id",
        "type": "string"
      },
      "sequence_no": {
        "title": "Sequence No",
        "type": "integer"
      },
      "event_type": {
        "$ref": "#/$defs/LedgerEventType"
      },
      "event_ref": {
        "title": "Event Ref",
        "type": "string"
      },
      "idempotency_key": {
        "title": "Idempotency Key",
        "type": "string"
      },
      "lines": {
        "items": {
          "$ref": "#/$defs/PostingLine"
        },
        "title": "Lines",
        "type": "array"
      },
      "lines_digest": {
        "title": "Lines Digest",
        "type": "string"
      },
      "prev_hash": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Prev Hash"
      },
      "entry_hash": {
        "title": "Entry Hash",
        "type": "string"
      },
      "audit_event_id": {
        "format": "uuid",
        "title": "Audit Event Id",
        "type": "string"
      },
      "posted_at": {
        "format": "date-time",
        "title": "Posted At",
        "type": "string"
      },
      "replayed": {
        "default": false,
        "title": "Replayed",
        "type": "boolean"
      },
      "schema_version": {
        "const": "v1",
        "default": "v1",
        "title": "Schema Version",
        "type": "string"
      }
    },
    "required": [
      "entry_id",
      "sequence_no",
      "event_type",
      "event_ref",
      "idempotency_key",
      "lines",
      "lines_digest",
      "prev_hash",
      "entry_hash",
      "audit_event_id",
      "posted_at"
    ],
    "title": "JournalEntryView",
    "type": "object"
  },
