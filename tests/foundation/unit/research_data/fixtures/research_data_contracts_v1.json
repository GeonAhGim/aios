{
  "ResearchItem": {
    "description": "A single research item (the common envelope for filings, news, macro,\nand alt data).\n\n`known_at` is when the system could have known this fact -- backtests\nand strategies only ever read `known_at <= bar_ts` (§1 point-in-time\nintegrity, RD-A1). The check itself is\n`domain/known_at.assert_point_in_time`'s job (this file only defines the\ncontract). When `revision_of` is set, this item is a correction of that\n`item_id` (input for RD-3; this leaf does not enforce chain rules).",
    "properties": {
      "item_id": {
        "format": "uuid",
        "title": "Item Id",
        "type": "string"
      },
      "source_id": {
        "title": "Source Id",
        "type": "string"
      },
      "kind": {
        "enum": [
          "filing",
          "news",
          "macro",
          "alt"
        ],
        "title": "Kind",
        "type": "string"
      },
      "published_at": {
        "format": "date-time",
        "title": "Published At",
        "type": "string"
      },
      "known_at": {
        "format": "date-time",
        "title": "Known At",
        "type": "string"
      },
      "instruments": {
        "items": {
          "type": "string"
        },
        "title": "Instruments",
        "type": "array"
      },
      "title": {
        "title": "Title",
        "type": "string"
      },
      "body_ref": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Body Ref"
      },
      "url": {
        "title": "Url",
        "type": "string"
      },
      "language": {
        "title": "Language",
        "type": "string"
      },
      "hash": {
        "title": "Hash",
        "type": "string"
      },
      "revision_of": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Revision Of"
      },
      "schema_version": {
        "const": "v1",
        "default": "v1",
        "title": "Schema Version",
        "type": "string"
      }
    },
    "required": [
      "item_id",
      "source_id",
      "kind",
      "published_at",
      "known_at",
      "instruments",
      "title",
      "body_ref",
      "url",
      "language",
      "hash",
      "revision_of"
    ],
    "title": "ResearchItem",
    "type": "object"
  },
  "SourceMeta": {
    "description": "Per-source metadata -- the basis for enforcing license/collection\npolicy (RD-A3, input to RD-3).\n\n`rate_limit` is the allowed requests per minute (a declared token-bucket\nparameter; the actual limiting is the collector adapter's\nresponsibility -- the same principle as `RateLimitSpec` in\n`market_data/ports/provider.py`). `coverage` is a human-readable\ncoverage description (e.g. \"2015-01-01~present, 5 min delay\") --\nstructured coverage determination is DC-19 through 22's job.",
    "properties": {
      "source_id": {
        "title": "Source Id",
        "type": "string"
      },
      "publisher": {
        "title": "Publisher",
        "type": "string"
      },
      "redistribution": {
        "enum": [
          "store_full",
          "store_excerpt",
          "link_only"
        ],
        "title": "Redistribution",
        "type": "string"
      },
      "license_ref": {
        "title": "License Ref",
        "type": "string"
      },
      "rate_limit": {
        "title": "Rate Limit",
        "type": "integer"
      },
      "coverage": {
        "title": "Coverage",
        "type": "string"
      },
      "schema_version": {
        "const": "v1",
        "default": "v1",
        "title": "Schema Version",
        "type": "string"
      }
    },
    "required": [
      "source_id",
      "publisher",
      "redistribution",
      "license_ref",
      "rate_limit",
      "coverage"
    ],
    "title": "SourceMeta",
    "type": "object"
  }
}
