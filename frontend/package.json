{
  "name": "mihwa-aios-frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "test": "npm run test --workspaces --if-present",
    "check:filesize": "node scripts/check_frontend_file_size.mjs",
    "check:unwired-modules": "node scripts/check_unwired_modules.mjs",
    "test:unwired-modules": "node --test scripts/check_unwired_modules.test.mjs",
    "bench:density": "npm run bench:density --workspace=packages/chart-engine",
    "check:coverage": "npm run test:coverage --workspace=apps/web && node ../scripts/frontend_coverage_ratchet.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
