# --- 애플리케이션 ---
APP_ENV=development                    # development | staging | production
LOG_LEVEL=INFO

# --- 데이터베이스 (ADR-2026-08-10-B: PostgreSQL + SQLAlchemy async + asyncpg) ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aios_dev

# --- 인증 (FD-11.1, ADR-2026-08-10-B: JWT) ---
JWT_SECRET_KEY=                        # openssl rand -hex 32 등으로 생성, 절대 공유 금지
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# PLT-23/24 kid 회전 서명 키(src/services/auth/tokens.py) — 위 JWT_SECRET_KEY와는
# 별개 체계. "kid1:hex64,kid2:hex64" 형식, JWT_ACTIVE_KID로 발급용 kid를 고른다.
# 둘 다 미설정이면 TokenIssuer/TokenVerifier.from_env()가 fail-closed로 기동 거부.
JWT_SIGNING_KEYS=
JWT_ACTIVE_KID=

# --- 거래소 자격증명 암호화 (FD-12.1, AES-256-GCM) ---
CREDENTIAL_ENCRYPTION_KEY=             # 32바이트 키, openssl rand -hex 32
# PLT-31/34 kid 회전 키(src/core/security/key_ring.py) — CREDENTIAL_ENCRYPTION_KEY
# 단일 키를 대체하지 않고 병행("legacy" kid로 계속 복호). "kid:hex64,..." 형식.
# PAPER 스코프만 여기 둔다 — LIVE 스코프(CREDENTIAL_ENCRYPTION_KEYS_LIVE)는 현재
# PAPER 전용 단계에서 존재 자체가 fail-closed 거부 대상(I7, ADR-2026-08-29-E)이라
# 이 파일에 슬롯을 두지 않는다.
CREDENTIAL_ENCRYPTION_KEYS_PAPER=
CREDENTIAL_ENCRYPTION_ACTIVE_KID_PAPER=

# --- 거래소 API (로컬 개발/CI 테스트 전용 단일 계정) ---
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=   # Bitget API 키 생성 시 직접 정한 패스프레이즈(서명 필수)
# Bitget 데모 트레이딩용 별도 키(데모 모드에서 만든 키). 실계정 키와 분리해 PAPER 경로는 이쪽을 쓴다.
BITGET_DEMO_API_KEY=
BITGET_DEMO_API_SECRET=
BITGET_DEMO_API_PASSPHRASE=
KIS_APP_KEY=
KIS_APP_SECRET=
# 한국투자증권: 계좌번호 앞 8자리(CANO), 상품코드(ACNT_PRDT_CD, 보통 01), 모의투자 여부
KIS_CANO=
KIS_ACNT_PRDT_CD=01
KIS_PAPER_TRADING=true
# task-2787(BR-14) tests/integration/exchanges/kis/test_live_demo_roundtrip.py
# 전용 — tests/conftest.py가 KIS_APP_KEY/KIS_APP_SECRET를 항상 테스트 전용
# 고정값으로 덮어써서(운영자 자격증명 실수 사용 방지) 그 이름으로는 실계좌
# 유무를 판별할 수 없다. 모의투자 계좌가 생기면 아래 값을 채운다(위와 동일
# CANO/ACNT_PRDT_CD, KIS_LIVE_DEMO_ 접두만 다름).
KIS_LIVE_DEMO_APP_KEY=
KIS_LIVE_DEMO_APP_SECRET=
KIS_LIVE_DEMO_CANO=
KIS_LIVE_DEMO_ACNT_PRDT_CD=01
# 국내선물옵션 왕복 전용 — 월물마다 만기가 바뀌어 코드에 하드코딩할 수 없다.
# 현재 유효한 KOSPI200 선물/옵션 등 대표 월물 종목코드를 채운다.
KIS_LIVE_DEMO_KR_FUTURES_SYMBOL=
# NH투자증권(나무): 앱키·시크릿·계좌번호, 모의투자 여부
NH_APP_KEY=
NH_APP_SECRET=
NH_ACT_NO=
NH_PAPER_TRADING=true

# --- 알림 (FD-17.1) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FCM_SERVER_KEY=
APNS_KEY_ID=

# --- CORS (프론트엔드 로컬 개발) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- 백그라운드 루프 (FD-8 실행 루프 / 05번 §5.6 재시작 복구) ---
AIOS_EXECUTION_LOOP_ENABLED=1          # 0이면 실행 루프를 띄우지 않음(테스트·점검용)
AIOS_STARTUP_RECOVERY_ENABLED=1        # 0이면 기동 시 미결 주문 재조회를 건너뜀

# --- 런타임 모드 (PLT-31 I7, ADR-2026-08-29-E) ---
# PAPER | LIVE. 비어 있거나 오탈자 등 "LIVE"가 아닌 모든 값은 PAPER로 취급되어
# LIVE 암호화 키 존재 여부를 검사한다(src/core/security/key_ring.py, fail-closed
# 기본) — 현재 단계는 PAPER 전용이므로 이 값을 LIVE로 바꾸지 않는다.
AIOS_RUNTIME_MODE=

# --- /metrics 접근 토큰 (PLT-09) ---
# 비어 있으면 /metrics가 항상 403(fail-closed). X-Metrics-Token 헤더 값과
# hmac.compare_digest로 비교한다(src/api/routers/metrics.py).
AIOS_METRICS_TOKEN=

# 무료 데이터 소스 API 키 (발급 안내: API키_발급안내.txt / 근거 ADR-2026-09-06-A, H)
# 미설정이어도 앱은 기동한다. 해당 소스 어댑터만 fail-closed로 비활성된다.
OPENDART_API_KEY=
ECOS_API_KEY=
KOSIS_API_KEY=
FRED_API_KEY=
# SEC EDGAR는 키가 없다. User-Agent 미설정 시 403으로 차단된다.
SEC_EDGAR_USER_AGENT=
DATAGOKR_SERVICE_KEY=

# --- 운영 알림 웹훅 (H-10, ADR-2026-09-09-B) ---
# Slack Incoming Webhook URL. 비어 있으면 notify_selftest와 Alertmanager 라우팅이
# 알림을 발신하지 않고 실패로 기록한다(config/observability/alertmanager.yml,
# src/core/observability/notify_port.py, docs/runbooks/RB-10-notify.md 참고).
ALERT_WEBHOOK_URL=
