# --- 애플리케이션 ---
APP_ENV=development                    # development | staging | production
LOG_LEVEL=INFO

# --- 데이터베이스 (ADR-2026-08-10-B: PostgreSQL + SQLAlchemy async + asyncpg) ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aios_dev

# --- 인증 (FD-11.1, ADR-2026-08-10-B: JWT) ---
JWT_SECRET_KEY=                        # openssl rand -hex 32 등으로 생성, 절대 공유 금지
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# PLT-23/24 kid 회전 서명 키(src/services/auth/tokens.py) — 위 JWT_SECRET_KEY와는
# 별개 체계. "kid1:hex64,kid2:hex64" 형식, JWT_ACTIVE_KID로 발급용 kid를 고른다.
# 둘 다 미설정이면 TokenIssuer/TokenVerifier.from_env()가 fail-closed로 기동 거부.
JWT_SIGNING_KEYS=
JWT_ACTIVE_KID=

# --- 거래소 자격증명 암호화 (FD-12.1, AES-256-GCM) ---
CREDENTIAL_ENCRYPTION_KEY=             # 32바이트 키, openssl rand -hex 32
# PLT-31/34 kid 회전 키(src/core/security/key_ring.py) — CREDENTIAL_ENCRYPTION_KEY
# 단일 키를 대체하지 않고 병행("legacy" kid로 계속 복호). "kid:hex64,..." 형식.
# PAPER 스코프만 여기 둔다 — LIVE 스코프(CREDENTIAL_ENCRYPTION_KEYS_LIVE)는 현재
# PAPER 전용 단계에서 존재 자체가 fail-closed 거부 대상(I7, ADR-2026-08-29-E)이라
# 이 파일에 슬롯을 두지 않는다.
CREDENTIAL_ENCRYPTION_KEYS_PAPER=
CREDENTIAL_ENCRYPTION_ACTIVE_KID_PAPER=

# --- 거래소 API (로컬 개발/CI 테스트 전용 단일 계정) ---
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=   # Bitget API 키 생성 시 직접 정한 패스프레이즈(서명 필수)
# Bitget 데모 트레이딩용 별도 키(데모 모드에서 만든 키). 실계정 키와 분리해 PAPER 경로는 이쪽을 쓴다.
BITGET_DEMO_API_KEY=
BITGET_DEMO_API_SECRET=
BITGET_DEMO_API_PASSPHRASE=
KIS_APP_KEY=
KIS_APP_SECRET=
# 한국투자증권: 계좌번호 앞 8자리(CANO), 상품코드(ACNT_PRDT_CD, 보통 01), 모의투자 여부
KIS_CANO=
KIS_ACNT_PRDT_CD=01
KIS_PAPER_TRADING=true
# task-2787(BR-14) tests/integration/exchanges/kis/test_live_demo_roundtrip.py
# 전용 — tests/conftest.py가 KIS_APP_KEY/KIS_APP_SECRET를 항상 테스트 전용
# 고정값으로 덮어써서(운영자 자격증명 실수 사용 방지) 그 이름으로는 실계좌
# 유무를 판별할 수 없다. 모의투자 계좌가 생기면 아래 값을 채운다(위와 동일
# CANO/ACNT_PRDT_CD, KIS_LIVE_DEMO_ 접두만 다름).
KIS_LIVE_DEMO_APP_KEY=
KIS_LIVE_DEMO_APP_SECRET=
KIS_LIVE_DEMO_CANO=
KIS_LIVE_DEMO_ACNT_PRDT_CD=01
# 국내선물옵션 왕복 전용 — 월물마다 만기가 바뀌어 코드에 하드코딩할 수 없다.
# 현재 유효한 KOSPI200 선물/옵션 등 대표 월물 종목코드를 채운다.
KIS_LIVE_DEMO_KR_FUTURES_SYMBOL=
# NH투자증권(나무): 앱키·시크릿·계좌번호, 모의투자 여부
NH_APP_KEY=
NH_APP_SECRET=
NH_ACT_NO=
NH_PAPER_TRADING=true

# --- 알림 (FD-17.1) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FCM_SERVER_KEY=
APNS_KEY_ID=

# --- CORS (프론트엔드 로컬 개발) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- 백그라운드 루프 (FD-8 실행 루프 / 05번 §5.6 재시작 복구) ---
AIOS_EXECUTION_LOOP_ENABLED=1          # 0이면 실행 루프를 띄우지 않음(테스트·점검용)
AIOS_STARTUP_RECOVERY_ENABLED=1        # 0이면 기동 시 미결 주문 재조회를 건너뜀
# task-3829 -- src/main.py의 4개 정기 스케줄러 기동 플래그. flag_enabled()
# 기본값은 미설정 시 "1"(활성)이며 "0"일 때만 비활성(src/services/background_loops.py
# flag_enabled). 비활성 시 각 태스크는 asyncio.create_task로 생성되지 않고
# logger.warning만 남긴다 -- 해당 도메인 스케줄러를 완전히 멈추고 싶을 때만 0으로 둔다.
AIOS_LEDGER_SCHEDULER_ENABLED=1        # 0이면 원장 정합성/정산 루프(ledger_integrity, payout)를 띄우지 않음
AIOS_MARKET_DATA_SCHEDULER_ENABLED=1   # 0이면 시장데이터 품질 게이지 주기 export를 띄우지 않음(LA-18)
AIOS_POSITIONS_SCHEDULER_ENABLED=1     # 0이면 positions 마크/대사/NAV 주기 루프를 띄우지 않음(LB-17)
AIOS_ALGO_SCHEDULER_ENABLED=1          # 0이면 algo(TWAP/VWAP/POV/IS) tick 스케줄러를 띄우지 않음(EM-15)
# task-3829 -- src/services/background_loops.py의 선택적(optional) 백그라운드
# 태스크 기동 플래그. 위와 같은 flag_enabled() 관례(기본 활성, "0"이면 비활성).
AIOS_LIQUIDATION_WORKER_ENABLED=1      # 0이면 청산(liquidation) 워커 주기 루프를 띄우지 않음(R-52)
AIOS_POST_TRADE_BATCH_ENABLED=1        # 0이면 거래 후 배치(post-trade batch) 주기 루프를 띄우지 않음(CM-11/12)

# --- 런타임 모드 (PLT-31 I7, ADR-2026-08-29-E) ---
# PAPER | LIVE. 비어 있거나 오탈자 등 "LIVE"가 아닌 모든 값은 PAPER로 취급되어
# LIVE 암호화 키 존재 여부를 검사한다(src/core/security/key_ring.py, fail-closed
# 기본) — 현재 단계는 PAPER 전용이므로 이 값을 LIVE로 바꾸지 않는다.
AIOS_RUNTIME_MODE=

# --- /metrics 접근 토큰 (PLT-09) ---
# 비어 있으면 /metrics가 항상 403(fail-closed). X-Metrics-Token 헤더 값과
# hmac.compare_digest로 비교한다(src/api/routers/metrics.py).
AIOS_METRICS_TOKEN=

# 무료 데이터 소스 API 키 (발급 안내: API키_발급안내.txt / 근거 ADR-2026-09-06-A, H)
# 미설정이어도 앱은 기동한다. 해당 소스 어댑터만 fail-closed로 비활성된다.
OPENDART_API_KEY=
ECOS_API_KEY=
KOSIS_API_KEY=
FRED_API_KEY=
# SEC EDGAR는 키가 없다. User-Agent 미설정 시 403으로 차단된다.
SEC_EDGAR_USER_AGENT=
DATAGOKR_SERVICE_KEY=

# --- 운영 알림 웹훅 (H-10, ADR-2026-09-09-B) ---
# Slack Incoming Webhook URL. 비어 있으면 notify_selftest와 Alertmanager 라우팅이
# 알림을 발신하지 않고 실패로 기록한다(config/observability/alertmanager.yml,
# src/core/observability/notify_port.py, docs/runbooks/RB-10-notify.md 참고).
ALERT_WEBHOOK_URL=

# --- PERSONAL 모드 텔레그램 알림 (U-15, task-2749) ---
# 비어 있으면 체결·한도위반·kill 알림을 실제로 보내지 않고 ok=False로
# 기록한다(src/foundation/risk/adapters/telegram_adapter.py, 미설정을 성공으로
# 위장하지 않는다). 발급: @BotFather로 봇 생성 후 토큰 발급, 대화방에 봇을
# 추가하고 chat_id를 확인한다(docs/ops/PERSONAL_MODE.md 참고).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PAPER→LIVE 승격 체크리스트용 — ADR-2026-08-29-E §15.6-D 조건 2(4.9 Human
# Approval security: MFA+dual-approval이 실계좌에 실제 적용됨)가 실제로
# 충족됐는지는 코드가 스스로 검증할 수 없다(미검증). 기본값 비어있음(false로
# 취급, fail-closed) — 운영자가 조건을 직접 확인한 뒤에만 true로 바꾼다.
PERSONAL_ADR_0829E_CONDITION2_MET=

# personal-conservative 리스크 번들(U-15)을 실주문 PreSubmitGate 4층에서
# 실제로 강제할 계정/테넌트 id(task-3986). 비어 있으면(기본값) 4층은 어떤
# 계정에도 평가되지 않는다(전역 강제 금지) — 이 값과 일치하는 user_id의
# 주문만 personal-conservative 번들을 통과한다
# (src/foundation/risk/adapters/json_state_store.py,
# docs/ops/PERSONAL_MODE.md 참고).
PERSONAL_MODE_ACCOUNT_ID=

# --- U-3a AI 어시스턴트(task-2630, ADR-2026-09-09-B Decision C) ---
# 자연어 -> AIOS Script 생성/설명/백테스트 해설에 쓰는 기본 모델 공급자
# 키. 비어 있으면(기본값) src/foundation/ai/assistant/adapters/
# anthropic_provider.py가 ProviderNotConfiguredError(503)를 내고 생성을
# 시도하지 않는다(성공으로 위장하지 않는다).
ANTHROPIC_API_KEY=
# 비어 있으면 기본값(claude-sonnet-5)을 쓴다 — 설정으로 모델 교체 가능
# (decision, Claude 외 공급자로의 실제 스왑은 AI-7/AI-7b 후속 리프 소관).
AI_ASSISTANT_MODEL=
# 테넌트별 일일 요청 상한(비용 상한의 대리 지표 — AI-6 비용 계측 착륙
# 전까지). 비어 있으면 기본값 50.
AI_ASSISTANT_DAILY_CAP=
# 단계 공개 기능 플래그(§U 공통 DoD) — "1"이 아니면 세 엔드포인트 전부
# 404로 응답한다(있는 척하지 않는다).
FF_U3_AI_ASSISTANT=
